{
  "name": "leaderspath/activity-meta",
  "d4Shortcode": "",
  "title": "LeadersPath Activity Meta",
  "titles": "LeadersPath Activity Meta Modules",
  "moduleIcon": "divi/module",
  "moduleClassName": "leaderspath-activity-meta",
  "moduleOrderClassName": "leaderspath-activity-meta",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "styleProps": {
        "border": {
          "important": true
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "text": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designText",
              "priority": 5,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/text",
                "props": {
                  "grouped": false
                }
              }
            }
          },
          "htmlAttributes": {}
        },
        "decoration": {
          "attributes": {},
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "title": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-activity-meta__title",
      "tagName": "h3",
      "attributes": {
        "class": "leaderspath-activity-meta__title"
      },
      "inlineEditor": "plainText",
      "elementType": "heading",
      "childrenSanitizer": "et_core_esc_previously",
      "styleProps": {
        "font": {
          "important": {
            "font": {
              "desktop": {
                "value": {
                  "color": true
                }
              }
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentMain",
            "priority": 10,
            "render": true,
            "attrName": "title.innerContent",
            "label": "Title",
            "description": "Enter a title for this module (e.g., \"Activity Details\").",
            "features": {
              "sticky": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        },
        "decoration": {
          "font": {
            "priority": 10,
            "component": {
              "props": {
                "groupLabel": "Title Text",
                "fieldLabel": "Title",
                "fields": {
                  "headingLevel": {
                    "render": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "duration": {
      "type": "object",
      "settings": {
        "advanced": {
          "show": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentElements",
              "priority": 10,
              "render": true,
              "label": "Show Duration",
              "description": "Show or hide the activity duration.",
              "category": "configuration",
              "features": {
                "sticky": false,
                "responsive": false,
                "hover": false,
                "preset": ["html"]
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          }
        }
      }
    },
    "durationLabel": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-activity-meta__duration .leaderspath-activity-meta__label",
      "tagName": "span",
      "attributes": {
        "class": "leaderspath-activity-meta__label"
      },
      "childrenSanitizer": "esc_html",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "Duration:"
          }
        }
      },
      "styleProps": {
        "font": {
          "important": {
            "font": {
              "desktop": {
                "value": {
                  "color": true
                }
              }
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentElements",
            "priority": 11,
            "render": true,
            "attrName": "durationLabel.innerContent",
            "label": "Duration Label",
            "description": "Label text for the duration field.",
            "features": {
              "sticky": false,
              "responsive": false,
              "hover": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        },
        "decoration": {
          "font": {
            "priority": 20,
            "component": {
              "props": {
                "groupLabel": "Label Text",
                "fieldLabel": "Label"
              }
            }
          }
        }
      }
    },
    "objectives": {
      "type": "object",
      "settings": {
        "advanced": {
          "show": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentElements",
              "priority": 20,
              "render": true,
              "label": "Show Objectives",
              "description": "Show or hide the learning objectives.",
              "category": "configuration",
              "features": {
                "sticky": false,
                "responsive": false,
                "hover": false,
                "preset": ["html"]
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          }
        }
      }
    },
    "objectivesLabel": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-activity-meta__objectives .leaderspath-activity-meta__label",
      "tagName": "span",
      "attributes": {
        "class": "leaderspath-activity-meta__label"
      },
      "childrenSanitizer": "esc_html",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "Learning Objectives:"
          }
        }
      },
      "styleProps": {
        "font": {
          "important": {
            "font": {
              "desktop": {
                "value": {
                  "color": true
                }
              }
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentElements",
            "priority": 21,
            "render": true,
            "attrName": "objectivesLabel.innerContent",
            "label": "Objectives Label",
            "description": "Label text for the objectives section.",
            "features": {
              "sticky": false,
              "responsive": false,
              "hover": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "settings": {
        "advanced": {
          "show": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentElements",
              "priority": 30,
              "render": true,
              "label": "Show AI Model",
              "description": "Show or hide the AI model information (only displays if chatbot is enabled).",
              "category": "configuration",
              "features": {
                "sticky": false,
                "responsive": false,
                "hover": false,
                "preset": ["html"]
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          }
        }
      }
    },
    "modelLabel": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-activity-meta__model .leaderspath-activity-meta__label",
      "tagName": "span",
      "attributes": {
        "class": "leaderspath-activity-meta__label"
      },
      "childrenSanitizer": "esc_html",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "AI Model:"
          }
        }
      },
      "styleProps": {
        "font": {
          "important": {
            "font": {
              "desktop": {
                "value": {
                  "color": true
                }
              }
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentElements",
            "priority": 31,
            "render": true,
            "attrName": "modelLabel.innerContent",
            "label": "Model Label",
            "description": "Label text for the AI model field.",
            "features": {
              "sticky": false,
              "responsive": false,
              "hover": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "title": {
      "subName": "title",
      "selectorSuffix": " .leaderspath-activity-meta__title",
      "label": "Title"
    },
    "section": {
      "subName": "section",
      "selectorSuffix": " .leaderspath-activity-meta__section",
      "label": "Section"
    },
    "label": {
      "subName": "label",
      "selectorSuffix": " .leaderspath-activity-meta__label",
      "label": "Label"
    },
    "value": {
      "subName": "value",
      "selectorSuffix": " .leaderspath-activity-meta__value",
      "label": "Value"
    },
    "list": {
      "subName": "list",
      "selectorSuffix": " .leaderspath-activity-meta__list",
      "label": "List"
    },
    "badge": {
      "subName": "badge",
      "selectorSuffix": " .leaderspath-activity-meta__badge",
      "label": "Badge"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentMain": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentMain",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Content"
          }
        }
      },
      "contentElements": {
        "panel": "content",
        "priority": 20,
        "groupName": "contentElements",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Elements"
          }
        }
      },
      "designText": {
        "panel": "design",
        "priority": 10,
        "groupName": "textStyle",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Text",
            "clipboardCategory": "style",
            "presetGroup": "divi/text"
          }
        }
      }
    }
  }
}
