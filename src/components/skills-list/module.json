      "elementType": "heading",
      "settings": {
        "decoration": {
          "font": {
            "priority": 5,
            "component": {
              "props": {
                "groupLabel": "Heading Text",
                "fieldLabel": "Heading",
                "fields": {
                  "headingLevel": { "render": false }
