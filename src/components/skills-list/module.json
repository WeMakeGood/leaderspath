          }
        },
        "background": {
          "selector": "{{selector}} .leaderspath_skills_list__card",
          "selectors": {
            "desktop": {
              "value": "{{selector}} .leaderspath_skills_list__card",
              "hover": "{{selector}} .leaderspath_skills_list__card:hover"
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "background": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designCard",
              "attrName": "card.decoration.background",
              "subName": "color",
              "label": "Card Background Color",
              "render": true,
              "priority": 10,
              "component": {
                "type": "field",
                "name": "divi/color-picker"
              }
            }
          },
          "border": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designCard",
              "priority": 20,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/border",
                "props": {
                  "grouped": true,
                  "fieldLabel": "Card"
                }
              }
            }
          },
          "spacing": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designCard",
              "priority": 30,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/spacing",
                "props": {
                  "grouped": true,
                  "fieldLabel": "Card"
                }
              }
            }
          },
          "boxShadow": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designCard",
              "priority": 40,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/box-shadow",
                "props": {
                  "grouped": true,
                  "fieldLabel": "Card"
                }
              }
            }
          }
        }
      }
    },
