              "groupSlug": "designIcon",
              "attrName": "cardIcon.advanced.size",
              "label": "Icon Size",
              "render": true,
              "priority": 20,
              "component": {
                "type": "field",
                "name": "divi/range",
                "props": {
                  "cssProperty": "font-size",
                  "min": 12,
                  "max": 96,
                  "step": 1
                }
              }
            }
          }
        }
      }
    },
