          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "content": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "showHeading": "on",
              "headingText": "Skills",
              "showIcon": "on",
              "showDescription": "on",
              "showMeta": "on"
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "showHeading": {
              "groupSlug": "contentElements",
              "attrName": "content.innerContent",
              "subName": "showHeading",
              "label": "Show Heading",
              "category": "basic_option",
              "features": { "hover": false, "sticky": false, "responsive": false },
              "render": true,
              "priority": 10,
              "component": { "type": "field", "name": "divi/toggle" }
            },
            "headingText": {
              "groupSlug": "contentElements",
              "attrName": "content.innerContent",
              "subName": "headingText",
              "label": "Heading Text",
              "category": "basic_option",
              "features": { "hover": false, "sticky": false, "responsive": false },
              "render": true,
              "priority": 15,
              "component": { "name": "divi/text", "type": "field" }
            },
            "showIcon": {
              "groupSlug": "contentElements",
              "attrName": "content.innerContent",
              "subName": "showIcon",
              "label": "Show Icon",
              "category": "basic_option",
              "features": { "hover": false, "sticky": false, "responsive": false },
