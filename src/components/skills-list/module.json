              "component": { "type": "field", "name": "divi/toggle" }
            },
            "showMeta": {
              "groupSlug": "contentElements",
              "attrName": "content.innerContent",
              "subName": "showMeta",
              "label": "Show Compatibility & Version",
              "category": "basic_option",
              "features": { "hover": false, "sticky": false, "responsive": false },
              "render": true,
              "priority": 30,
              "component": { "type": "field", "name": "divi/toggle" }
            }
          }
        }
      }
    },
    "grid": {
      "type": "object",
      "selector": "{{selector}} .leaderspath_skills_list__grid",
      "tagName": "ul",
      "elementType": "element",
      "settings": {
        "decoration": {
          "layout": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designLayout",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/layout",
                "props": {
                  "grouped": false,
                  "defaultGroupAttr": {
                    "desktop": {
                      "value": {
                        "display": "grid",
                        "gridColumnCount": "3",
                        "columnGap": "1.5em",
                        "rowGap": "1.5em"
                      }
                    }
                  },
                  "fields": {
                    "gridColumnCount": {
                      "baseFieldDefault": "3"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "heading": {
      "type": "object",
      "selector": "{{selector}} .leaderspath_skills_list__heading",
