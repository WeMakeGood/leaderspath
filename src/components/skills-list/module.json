          "background": {
            "desktop": {
              "value": {
                "color": "#f8f9fa"
              }
            }
          },
          "border": {
            "desktop": {
              "value": {
                "radius": {
                  "sync": "on",
                  "topLeft": "8px",
                  "topRight": "8px",
                  "bottomRight": "8px",
                  "bottomLeft": "8px"
                },
                "styles": {
                  "all": {
                    "width": "1px",
                    "color": "#e0e0e0",
                    "style": "solid"
                  }
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "spacing": {
          "selector": "{{selector}} .leaderspath_skills_list__card",
          "important": true
        },
        "boxShadow": {
          "selector": "{{selector}} .leaderspath_skills_list__card"
        },
        "border": {
          "selector": "{{selector}} .leaderspath_skills_list__card",
          "selectors": {
            "desktop": {
              "value": "{{selector}} .leaderspath_skills_list__card",
              "hover": "{{selector}} .leaderspath_skills_list__card:hover"
