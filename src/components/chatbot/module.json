{
  "name": "leaderspath/chatbot",
  "d4Shortcode": "",
  "title": "LeadersPath Chatbot",
  "titles": "LeadersPath Chatbot",
  "moduleIcon": "divi/module-comments",
  "moduleClassName": "leaderspath_chatbot",
  "moduleOrderClassName": "leaderspath_chatbot",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "decoration": {
          "sizing": {
            "desktop": {
              "value": {
                "height": "500px"
              }
            }
          }
        }
      },
      "styleProps": {
        "border": {
          "important": true
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "text": {},
          "htmlAttributes": {}
        },
        "decoration": {
          "attributes": {},
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "content": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "showHeading": "on",
              "headingText": "AI Sandbox",
              "emptyText": "Send a message to start the conversation."
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "showHeading": {
              "groupSlug": "contentElements",
              "attrName": "content.innerContent",
              "subName": "showHeading",
              "label": "Show Heading",
              "category": "basic_option",
              "features": { "hover": false, "sticky": false, "responsive": false },
              "render": true,
              "priority": 10,
              "component": { "type": "field", "name": "divi/toggle" }
            },
            "headingText": {
              "groupSlug": "contentElements",
              "attrName": "content.innerContent",
              "subName": "headingText",
              "label": "Heading Text",
              "category": "basic_option",
              "features": { "hover": false, "sticky": false, "responsive": false },
              "render": true,
              "priority": 15,
              "component": { "name": "divi/text", "type": "field" }
            },
            "emptyText": {
              "groupSlug": "contentElements",
              "attrName": "content.innerContent",
              "subName": "emptyText",
              "label": "Empty State Text",
              "category": "basic_option",
              "features": { "hover": false, "sticky": false, "responsive": false },
              "render": true,
              "priority": 20,
              "component": { "name": "divi/text", "type": "field" }
            }
          }
        }
      }
    },
    "heading": {
      "type": "object",
      "selector": "{{selector}} .leaderspath_chatbot__heading",
      "tagName": "h3",
      "elementType": "heading",
      "settings": {
        "decoration": {
          "font": {
            "priority": 5,
            "component": {
              "props": {
                "groupLabel": "Heading Text",
                "fieldLabel": "Heading",
                "fields": {
                  "headingLevel": { "render": false }
                }
              }
            }
          }
        }
      }
    },
    "container": {
      "type": "object",
      "selector": "{{selector}} .leaderspath_chatbot__container",
      "tagName": "div",
      "elementType": "element",
      "styleProps": {
        "spacing": {
          "selector": "{{selector}} .leaderspath_chatbot__container",
          "important": true
        },
        "boxShadow": {
          "selector": "{{selector}} .leaderspath_chatbot__container"
        },
        "border": {
          "selector": "{{selector}} .leaderspath_chatbot__container",
          "selectors": {
            "desktop": {
              "value": "{{selector}} .leaderspath_chatbot__container",
              "hover": "{{selector}}:hover .leaderspath_chatbot__container"
            }
          }
        },
        "background": {
          "selector": "{{selector}} .leaderspath_chatbot__container",
          "selectors": {
            "desktop": {
              "value": "{{selector}} .leaderspath_chatbot__container",
              "hover": "{{selector}}:hover .leaderspath_chatbot__container"
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "background": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designContainer",
              "attrName": "container.decoration.background",
              "subName": "color",
              "label": "Container Background",
              "render": true,
              "priority": 10,
              "component": {
                "type": "field",
                "name": "divi/color-picker"
              }
            }
          },
          "border": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designContainer",
              "priority": 20,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/border",
                "props": {
                  "grouped": true,
                  "fieldLabel": "Container"
                }
              }
            }
          },
          "spacing": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designContainer",
              "priority": 30,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/spacing",
                "props": {
                  "grouped": true,
                  "fieldLabel": "Container"
                }
              }
            }
          },
          "boxShadow": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designContainer",
              "priority": 40,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/box-shadow",
                "props": {
                  "grouped": true,
                  "fieldLabel": "Container"
                }
              }
            }
          }
        }
      }
    },
    "userMessage": {
      "type": "object",
      "selector": "{{selector}} .leaderspath_chatbot__message--user .leaderspath_chatbot__message__content",
      "tagName": "div",
      "elementType": "heading",
      "styleProps": {
        "background": {
          "selector": "{{selector}} .leaderspath_chatbot__message--user .leaderspath_chatbot__message__content",
          "selectors": {
            "desktop": {
              "value": "{{selector}} .leaderspath_chatbot__message--user .leaderspath_chatbot__message__content",
              "hover": "{{selector}}:hover .leaderspath_chatbot__message--user .leaderspath_chatbot__message__content"
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "font": {
            "priority": 10,
            "component": {
              "props": {
                "groupLabel": "User Message",
                "fieldLabel": "User",
                "fields": {
                  "headingLevel": { "render": false }
                }
              }
            }
          },
          "background": {
            "priority": 11,
            "component": {
              "props": {
                "grouped": true,
                "fieldLabel": "User Bubble",
                "fields": {
                  "gradient": { "render": false },
                  "image": { "render": false },
                  "video": { "render": false },
                  "pattern": { "render": false },
                  "mask": { "render": false }
                }
              }
            }
          }
        }
      }
    },
    "assistantMessage": {
      "type": "object",
      "selector": "{{selector}} .leaderspath_chatbot__message--assistant .leaderspath_chatbot__message__content",
      "tagName": "div",
      "elementType": "heading",
      "styleProps": {
        "background": {
          "selector": "{{selector}} .leaderspath_chatbot__message--assistant .leaderspath_chatbot__message__content",
          "selectors": {
            "desktop": {
              "value": "{{selector}} .leaderspath_chatbot__message--assistant .leaderspath_chatbot__message__content",
              "hover": "{{selector}}:hover .leaderspath_chatbot__message--assistant .leaderspath_chatbot__message__content"
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "font": {
            "priority": 15,
            "component": {
              "props": {
                "groupLabel": "Assistant Message",
                "fieldLabel": "Assistant",
                "fields": {
                  "headingLevel": { "render": false }
                }
              }
            }
          },
          "background": {
            "priority": 16,
            "component": {
              "props": {
                "grouped": true,
                "fieldLabel": "Assistant Bubble",
                "fields": {
                  "gradient": { "render": false },
                  "image": { "render": false },
                  "video": { "render": false },
                  "pattern": { "render": false },
                  "mask": { "render": false }
                }
              }
            }
          }
        }
      }
    },
    "inputField": {
      "type": "object",
      "selector": "{{selector}} .leaderspath_chatbot__input",
      "tagName": "textarea",
      "elementType": "heading",
      "settings": {
        "decoration": {
          "font": {
            "priority": 20,
            "component": {
              "props": {
                "groupLabel": "Input Field",
                "fieldLabel": "Input",
                "fields": {
                  "headingLevel": { "render": false }
                }
              }
            }
          }
        }
      }
    },
    "sendButton": {
      "type": "object",
      "selector": "{{selector}} .leaderspath_chatbot__send",
      "tagName": "button",
      "elementType": "button",
      "elementProps": {
        "type": "button"
      },
      "settings": {
        "decoration": {
          "button": {
            "priority": 25,
            "component": {
              "props": {
                "groupLabel": "Send Button",
                "fields": {
                  "alignment": { "render": false },
                  "boxShadowGroup": { "render": false },
                  "buttonIconGroup": { "render": false },
                  "spacingGroup": { "render": false },
                  "fontGroup": {
                    "component": {
                      "props": {
                        "fields": {
                          "textAlign": { "render": false }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "container": {
      "subName": "container",
      "selectorSuffix": " .leaderspath_chatbot__container"
    },
    "heading": {
      "subName": "heading",
      "selectorSuffix": " .leaderspath_chatbot__heading"
    },
    "messages": {
      "subName": "messages",
      "selectorSuffix": " .leaderspath_chatbot__messages"
    },
    "userMessage": {
      "subName": "userMessage",
      "selectorSuffix": " .leaderspath_chatbot__message--user .leaderspath_chatbot__message__content"
    },
    "assistantMessage": {
      "subName": "assistantMessage",
      "selectorSuffix": " .leaderspath_chatbot__message--assistant .leaderspath_chatbot__message__content"
    },
    "inputArea": {
      "subName": "inputArea",
      "selectorSuffix": " .leaderspath_chatbot__input_area"
    },
    "inputField": {
      "subName": "inputField",
      "selectorSuffix": " .leaderspath_chatbot__input"
    },
    "sendButton": {
      "subName": "sendButton",
      "selectorSuffix": " .leaderspath_chatbot__send"
    },
    "modelSelect": {
      "subName": "modelSelect",
      "selectorSuffix": " .leaderspath_chatbot__model_select"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentElements": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentElements",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Elements"
          }
        }
      },
      "designContainer": {
        "panel": "design",
        "priority": 10,
        "groupName": "container",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Container",
            "clipboardCategory": "style"
          }
        }
      }
    }
  }
}
