{
  "name": "leaderspath/lesson-objectives",
  "d4Shortcode": "",
  "title": "LeadersPath Lesson Objectives",
  "titles": "LeadersPath Lesson Objectives Modules",
  "moduleIcon": "divi/module",
  "moduleClassName": "leaderspath-lesson-objectives",
  "moduleOrderClassName": "leaderspath-lesson-objectives",
  "category": "module",
  "childrenName": [],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Lesson Objectives"
            }
          }
        }
      },
      "styleProps": {
        "border": {
          "important": true
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "text": {
            "component": {
              "props": {
                "fields": {
                  "color": {
                    "render": false
                  }
                }
              }
            }
          },
          "htmlAttributes": {}
        },
        "decoration": {
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "title": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-lesson-objectives__title",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "Learning Objectives"
          }
        }
      },
      "defaultPrintedStyle": {
        "decoration": {
          "font": {
            "font": {
              "desktop": {
                "value": {
                  "size": "22px",
                  "lineHeight": "1.3em",
                  "weight": "600"
                }
              }
            }
          }
        }
      },
      "tagName": "h3",
      "attributes": {
        "class": "leaderspath-lesson-objectives__title"
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentTitle",
            "attrName": "title.innerContent",
            "label": "Title",
            "description": "Enter the module heading title.",
            "priority": 10,
            "render": true,
            "features": {
              "dynamicContent": false,
              "sticky": false
            },
            "component": {
              "type": "field",
              "name": "divi/text"
            }
          }
        },
        "decoration": {
          "font": {
            "priority": 10,
            "component": {
              "props": {
                "groupLabel": "Title Text",
                "fieldLabel": "Title",
                "fields": {
                  "headingLevel": {
                    "render": true
                  }
                }
              }
            }
          }
        }
      },
      "elementType": "heading",
      "inlineEditor": "plainText",
      "childrenSanitizer": "et_core_esc_previously"
    },
    "emptyState": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-lesson-objectives__empty",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "No learning objectives have been defined for this lesson."
          }
        }
      },
      "tagName": "div",
      "attributes": {
        "class": "leaderspath-lesson-objectives__empty"
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentEmptyState",
            "attrName": "emptyState.innerContent",
            "label": "Empty State Message",
            "description": "Message shown when no objectives are available.",
            "priority": 10,
            "render": true,
            "features": {
              "dynamicContent": false,
              "sticky": false
            },
            "component": {
              "type": "field",
              "name": "divi/richtext"
            }
          }
        },
        "decoration": {
          "bodyFont": {
            "attrName": "emptyState.decoration.bodyFont"
          }
        }
      },
      "inlineEditor": "richText",
      "childrenSanitizer": "et_core_esc_previously"
    },
    "list": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-lesson-objectives__list",
      "settings": {
        "decoration": {
          "layout": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designLayout",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/layout",
                "props": {
                  "grouped": false,
                  "defaultGroupAttr": {
                    "desktop": {
                      "value": {
                        "flexDirection": "column",
                        "rowGap": "8px"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-lesson-objectives__item",
      "defaultPrintedStyle": {
        "decoration": {
          "bodyFont": {
            "body": {
              "font": {
                "desktop": {
                  "value": {
                    "lineHeight": "1.5em"
                  }
                }
              }
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "bodyFont": {
            "priority": 20,
            "attrName": "item.decoration.bodyFont",
            "component": {
              "props": {
                "groupLabel": "Item Text"
              }
            }
          }
        }
      }
    },
    "css": {
      "type": "object",
      "settings": {
        "advanced": {
          "customCss": {},
          "cssId": {},
          "cssClass": {}
        }
      }
    }
  },
  "customCssFields": {
    "content": {
      "subName": "content",
      "selectorSuffix": " .leaderspath-lesson-objectives__content",
      "label": "Content"
    },
    "title": {
      "subName": "title",
      "selectorSuffix": " .leaderspath-lesson-objectives__title",
      "label": "Title"
    },
    "list": {
      "subName": "list",
      "selectorSuffix": " .leaderspath-lesson-objectives__list",
      "label": "List"
    },
    "item": {
      "subName": "item",
      "selectorSuffix": " .leaderspath-lesson-objectives__item",
      "label": "List Item"
    },
    "empty": {
      "subName": "empty",
      "selectorSuffix": " .leaderspath-lesson-objectives__empty",
      "label": "Empty State"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentTitle": {
        "panel": "content",
        "priority": 10,
        "groupName": "title",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Title"
          }
        }
      },
      "contentEmptyState": {
        "panel": "content",
        "priority": 20,
        "groupName": "emptyState",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Empty State"
          }
        }
      },
      "designLayout": {
        "panel": "design",
        "priority": 5,
        "groupName": "layout",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Layout",
            "clipboardCategory": "style",
            "presetGroup": "divi/layout"
          }
        }
      }
    }
  }
}
