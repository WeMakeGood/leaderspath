{
  "name": "leaderspath/lesson-objectives",
  "d4Shortcode": "",
  "title": "LeadersPath Lesson Objectives",
  "titles": "LeadersPath Lesson Objectives Modules",
  "moduleIcon": "divi/module",
  "moduleClassName": "leaderspath-lesson-objectives",
  "moduleOrderClassName": "leaderspath-lesson-objectives",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "styleProps": {
        "border": {
          "important": true
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "text": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designText",
              "priority": 5,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/text",
                "props": {
                  "grouped": false
                }
              }
            }
          },
          "htmlAttributes": {}
        },
        "decoration": {
          "attributes": {},
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "title": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-lesson-objectives__title",
      "tagName": "h3",
      "attributes": {
        "class": "leaderspath-lesson-objectives__title"
      },
      "inlineEditor": "plainText",
      "elementType": "heading",
      "childrenSanitizer": "et_core_esc_previously",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "Learning Objectives"
          }
        }
      },
      "styleProps": {
        "font": {
          "important": {
            "font": {
              "desktop": {
                "value": {
                  "color": true
                }
              }
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentMain",
            "priority": 10,
            "render": true,
            "attrName": "title.innerContent",
            "label": "Title",
            "description": "Enter a title for this module (e.g., \"Learning Objectives\").",
            "features": {
              "sticky": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        },
        "decoration": {
          "font": {
            "priority": 10,
            "component": {
              "props": {
                "groupLabel": "Title Text",
                "fieldLabel": "Title",
                "fields": {
                  "headingLevel": {
                    "render": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "emptyState": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-lesson-objectives__empty",
      "tagName": "p",
      "attributes": {
        "class": "leaderspath-lesson-objectives__empty-text"
      },
      "childrenSanitizer": "esc_html",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "No learning objectives have been defined for this lesson."
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentMain",
            "priority": 20,
            "render": true,
            "attrName": "emptyState.innerContent",
            "label": "Empty State Message",
            "description": "Message to display when no objectives are available.",
            "features": {
              "sticky": false,
              "responsive": false,
              "hover": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "title": {
      "subName": "title",
      "selectorSuffix": " .leaderspath-lesson-objectives__title",
      "label": "Title"
    },
    "list": {
      "subName": "list",
      "selectorSuffix": " .leaderspath-lesson-objectives__list",
      "label": "List"
    },
    "item": {
      "subName": "item",
      "selectorSuffix": " .leaderspath-lesson-objectives__item",
      "label": "List Item"
    },
    "empty": {
      "subName": "empty",
      "selectorSuffix": " .leaderspath-lesson-objectives__empty",
      "label": "Empty State"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentMain": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentMain",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Content"
          }
        }
      },
      "designText": {
        "panel": "design",
        "priority": 10,
        "groupName": "textStyle",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Text",
            "clipboardCategory": "style",
            "presetGroup": "divi/text"
          }
        }
      }
    }
  }
}
