{
  "name": "leaderspath/lesson-objectives",
  "d4Shortcode": "",
  "title": "LeadersPath Lesson Objectives",
  "titles": "LeadersPath Lesson Objectives",
  "moduleIcon": "divi/module-icon-list",
  "moduleClassName": "leaderspath_lesson_objectives",
  "moduleOrderClassName": "leaderspath_lesson_objectives",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "styleProps": {
        "border": {
          "important": true
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "text": {},
          "htmlAttributes": {}
        },
        "decoration": {
          "attributes": {},
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "content": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "showHeading": "on",
              "headingText": "Learning Objectives"
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "showHeading": {
              "groupSlug": "contentElements",
              "attrName": "content.innerContent",
              "subName": "showHeading",
              "label": "Show Heading",
              "category": "basic_option",
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false
              },
              "render": true,
              "priority": 10,
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            },
            "headingText": {
              "groupSlug": "contentElements",
              "attrName": "content.innerContent",
              "subName": "headingText",
              "label": "Heading Text",
              "category": "basic_option",
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false
              },
              "render": true,
              "priority": 15,
              "component": {
                "name": "divi/text",
                "type": "field"
              }
            }
          }
        }
      }
    },
    "list": {
      "type": "object",
      "selector": "{{selector}} .leaderspath_lesson_objectives__list",
      "tagName": "ol",
      "elementType": "element",
      "settings": {
        "decoration": {
          "layout": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designLayout",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/layout",
                "props": {
                  "grouped": false,
                  "defaultGroupAttr": {
                    "desktop": {
                      "value": {
                        "display": "flex",
                        "flexDirection": "column",
                        "flexWrap": "nowrap",
                        "rowGap": "0.75em"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "heading": {
      "type": "object",
      "selector": "{{selector}} .leaderspath_lesson_objectives__heading",
      "tagName": "h3",
      "elementType": "heading",
      "settings": {
        "decoration": {
          "font": {
            "priority": 5,
            "component": {
              "props": {
                "groupLabel": "Heading Text",
                "fieldLabel": "Heading",
                "fields": {
                  "headingLevel": { "render": false }
                }
              }
            }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "selector": "{{selector}} .leaderspath_lesson_objectives__item",
      "tagName": "li",
      "elementType": "heading",
      "settings": {
        "decoration": {
          "font": {
            "priority": 10,
            "component": {
              "props": {
                "groupLabel": "Item Text",
                "fieldLabel": "Item",
                "fields": {
                  "headingLevel": { "render": false }
                }
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "heading": {
      "subName": "heading",
      "selectorSuffix": " .leaderspath_lesson_objectives__heading"
    },
    "list": {
      "subName": "list",
      "selectorSuffix": " .leaderspath_lesson_objectives__list"
    },
    "item": {
      "subName": "item",
      "selectorSuffix": " .leaderspath_lesson_objectives__item"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentElements": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentElements",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Elements"
          }
        }
      },
      "designLayout": {
        "panel": "design",
        "priority": 10,
        "groupName": "designLayout",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Layout",
            "clipboardCategory": "style",
            "presetGroup": "divi/layout"
          }
        }
      }
    }
  }
}
