      "type": "object",
      "selector": "{{selector}} .leaderspath-lesson-activities__item",
      "defaultPrintedStyle": {
        "decoration": {
          "background": {
            "color": {
              "desktop": {
                "value": "#f8f9fa"
              }
            }
          },
          "border": {
            "radius": {
              "desktop": {
                "value": {
                  "sync": true,
                  "topLeft": "4px",
                  "topRight": "4px",
                  "bottomRight": "4px",
                  "bottomLeft": "4px"
                }
              }
            }
          },
          "spacing": {
            "padding": {
              "desktop": {
                "value": {
                  "top": "12px",
                  "right": "16px",
                  "bottom": "12px",
                  "left": "16px"
                }
              }
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "background": {
            "priority": 20,
            "component": {
              "props": {
                "groupLabel": "Item Background"
              }
            }
          },
          "border": {
            "priority": 30,
            "component": {
              "props": {
                "groupLabel": "Item Border"
              }
            }
          },
          "spacing": {
            "priority": 40,
            "component": {
              "props": {
                "groupLabel": "Item Spacing"
              }
            }
          }
        }
      }
    },
    "numberBadge": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-lesson-activities__number",
      "defaultPrintedStyle": {
        "decoration": {
          "background": {
            "color": {
              "desktop": {
                "value": "#0073aa"
              }
            }
          },
          "font": {
            "font": {
              "desktop": {
                "value": {
                  "size": "14px",
                  "weight": "600",
                  "color": "#ffffff"
                }
              }
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "background": {
            "priority": 50,
            "component": {
              "props": {
                "groupLabel": "Number Badge Background"
              }
            }
          },
          "font": {
            "priority": 60,
            "component": {
              "props": {
                "groupLabel": "Number Badge Text",
                "fieldLabel": "Number Badge"
              }
            }
          }
        }
      }
    },
    "link": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-lesson-activities__link",
      "defaultPrintedStyle": {
        "decoration": {
          "font": {
            "font": {
              "desktop": {
                "value": {
                  "color": "#0073aa",
                  "weight": "500"
                }
              }
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "font": {
            "priority": 70,
            "component": {
              "props": {
                "groupLabel": "Link Text",
                "fieldLabel": "Link"
              }
            }
          }
        }
      }
    },
    "css": {
      "type": "object",
      "settings": {
        "advanced": {
          "customCss": {},
          "cssId": {},
          "cssClass": {}
        }
      }
    }
  },
  "customCssFields": {
    "content": {
      "subName": "content",
      "selectorSuffix": " .leaderspath-lesson-activities__content",
      "label": "Content"
    },
    "title": {
      "subName": "title",
      "selectorSuffix": " .leaderspath-lesson-activities__title",
      "label": "Title"
    },
    "list": {
      "subName": "list",
      "selectorSuffix": " .leaderspath-lesson-activities__list",
      "label": "List"
    },
    "item": {
      "subName": "item",
      "selectorSuffix": " .leaderspath-lesson-activities__item",
      "label": "List Item"
    },
    "number": {
      "subName": "number",
      "selectorSuffix": " .leaderspath-lesson-activities__number",
