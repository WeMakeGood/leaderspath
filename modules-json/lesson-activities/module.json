  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentTitle": {
        "panel": "content",
        "priority": 10,
        "groupName": "title",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Title"
          }
        }
      },
      "contentEmptyState": {
        "panel": "content",
        "priority": 20,
        "groupName": "emptyState",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Empty State"
          }
        }
      },
      "designLayout": {
        "panel": "design",
        "priority": 5,
        "groupName": "layout",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Layout",
            "clipboardCategory": "style",
            "presetGroup": "divi/layout"
          }
        }
