  "category": "module",
  "childrenName": [],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Lesson Activities"
            }
          }
        }
      },
      "styleProps": {
        "border": {
          "important": true
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "text": {
            "component": {
              "props": {
                "fields": {
                  "color": {
                    "render": false
                  }
                }
              }
            }
          },
          "htmlAttributes": {}
        },
        "decoration": {
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "title": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-lesson-activities__title",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "Lesson Activities"
          }
        }
      },
      "defaultPrintedStyle": {
        "decoration": {
          "font": {
            "font": {
              "desktop": {
                "value": {
                  "size": "22px",
                  "lineHeight": "1.3em",
                  "weight": "600"
                }
              }
            }
          }
        }
      },
      "tagName": "h3",
      "attributes": {
        "class": "leaderspath-lesson-activities__title"
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentTitle",
            "attrName": "title.innerContent",
            "label": "Title",
            "description": "Enter the module heading title.",
            "priority": 10,
            "render": true,
            "features": {
              "dynamicContent": false,
              "sticky": false
            },
            "component": {
              "type": "field",
              "name": "divi/text"
            }
          }
        },
        "decoration": {
          "font": {
            "priority": 10,
            "component": {
              "props": {
                "groupLabel": "Title Text",
                "fieldLabel": "Title",
                "fields": {
                  "headingLevel": {
                    "render": true
                  }
                }
              }
            }
          }
        }
      },
      "elementType": "heading",
      "inlineEditor": "plainText",
      "childrenSanitizer": "et_core_esc_previously"
    },
    "emptyState": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-lesson-activities__empty",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "No activities have been assigned to this lesson."
          }
        }
      },
      "tagName": "div",
      "attributes": {
        "class": "leaderspath-lesson-activities__empty"
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentEmptyState",
            "attrName": "emptyState.innerContent",
            "label": "Empty State Message",
            "description": "Message shown when no activities are available.",
            "priority": 10,
            "render": true,
            "features": {
              "dynamicContent": false,
              "sticky": false
            },
            "component": {
              "type": "field",
              "name": "divi/richtext"
            }
          }
        },
        "decoration": {
          "bodyFont": {
            "attrName": "emptyState.decoration.bodyFont"
          }
        }
      },
      "inlineEditor": "richText",
      "childrenSanitizer": "et_core_esc_previously"
    },
    "list": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-lesson-activities__list",
      "settings": {
        "decoration": {
          "layout": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designLayout",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/layout",
                "props": {
                  "grouped": false,
                  "defaultGroupAttr": {
                    "desktop": {
                      "value": {
                        "flexDirection": "column",
                        "rowGap": "12px"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
