{
  "name": "leaderspath/lesson-meta",
  "d4Shortcode": "",
  "title": "Lesson Meta",
  "titles": "Lesson Meta Modules",
  "moduleIcon": "divi/module",
  "moduleClassName": "leaderspath-lesson-meta",
  "moduleOrderClassName": "leaderspath-lesson-meta",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "styleProps": {
        "border": {
          "important": true
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "text": {},
          "htmlAttributes": {}
        },
        "decoration": {
          "attributes": {},
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "title": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-lesson-meta__title",
      "styleProps": {
        "font": {
          "important": {
            "font": {
              "desktop": {
                "value": {
                  "color": true
                }
              }
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentMain",
            "priority": 10,
            "render": true,
            "attrName": "title.innerContent",
            "label": "Title",
            "description": "Enter a title for this module.",
            "features": {
              "sticky": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        },
        "decoration": {
          "font": {
            "priority": 10,
            "component": {
              "props": {
                "groupLabel": "Title Text",
                "fieldLabel": "Title",
                "fields": {
                  "headingLevel": {
                    "render": false
                  }
                }
              }
            }
          }
        }
      },
      "tagName": "h3",
      "attributes": {
        "class": "leaderspath-lesson-meta__title"
      },
      "inlineEditor": "plainText",
      "elementType": "heading",
      "childrenSanitizer": "et_core_esc_previously"
    },
    "showDuration": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "on"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentElements",
            "priority": 10,
            "render": true,
            "attrName": "showDuration.innerContent",
            "label": "Show Duration",
            "description": "Show or hide the lesson duration.",
            "features": {
              "sticky": false,
              "responsive": false,
              "hover": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/toggle",
              "type": "field"
            }
          }
        }
      }
    },
    "durationLabel": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "Duration:"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentElements",
            "priority": 11,
            "render": true,
            "attrName": "durationLabel.innerContent",
            "label": "Duration Label",
            "description": "Label text for the duration field.",
            "features": {
              "sticky": false,
              "responsive": false,
              "hover": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        }
      }
    },
    "showObjectives": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "on"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentElements",
            "priority": 20,
            "render": true,
            "attrName": "showObjectives.innerContent",
            "label": "Show Objectives",
            "description": "Show or hide the learning objectives.",
            "features": {
              "sticky": false,
              "responsive": false,
              "hover": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/toggle",
              "type": "field"
            }
          }
        }
      }
    },
    "objectivesLabel": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "Learning Objectives:"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentElements",
            "priority": 21,
            "render": true,
            "attrName": "objectivesLabel.innerContent",
            "label": "Objectives Label",
            "description": "Label text for the objectives section.",
            "features": {
              "sticky": false,
              "responsive": false,
              "hover": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        }
      }
    },
    "showModel": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "on"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentElements",
            "priority": 30,
            "render": true,
            "attrName": "showModel.innerContent",
            "label": "Show AI Model",
            "description": "Show or hide the AI model information (only displays if chatbot is enabled).",
            "features": {
              "sticky": false,
              "responsive": false,
              "hover": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/toggle",
              "type": "field"
            }
          }
        }
      }
    },
    "modelLabel": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "AI Model:"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentElements",
            "priority": 31,
            "render": true,
            "attrName": "modelLabel.innerContent",
            "label": "Model Label",
            "description": "Label text for the AI model field.",
            "features": {
              "sticky": false,
              "responsive": false,
              "hover": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "title": {
      "subName": "title",
      "selectorSuffix": " .leaderspath-lesson-meta__title"
    },
    "section": {
      "subName": "section",
      "selectorSuffix": " .leaderspath-lesson-meta__section"
    },
    "label": {
      "subName": "label",
      "selectorSuffix": " .leaderspath-lesson-meta__label"
    },
    "value": {
      "subName": "value",
      "selectorSuffix": " .leaderspath-lesson-meta__value"
    },
    "list": {
      "subName": "list",
      "selectorSuffix": " .leaderspath-lesson-meta__list"
    },
    "badge": {
      "subName": "badge",
      "selectorSuffix": " .leaderspath-lesson-meta__badge"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentMain": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentMain",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Content"
          }
        }
      },
      "contentElements": {
        "panel": "content",
        "priority": 20,
        "groupName": "contentElements",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Elements"
          }
        }
      }
    }
  }
}
