{
  "name": "leaderspath/context-library",
  "d4Shortcode": "",
  "title": "LeadersPath Context Library",
  "titles": "LeadersPath Context Libraries",
  "moduleIcon": "divi/module-code",
  "moduleClassName": "leaderspath-context-library",
  "moduleOrderClassName": "leaderspath-context-library",
  "category": "module",
  "childrenName": [],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Context Library"
            }
          }
        }
      },
      "styleProps": {
        "border": {
          "important": true
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "text": {
            "component": {
              "props": {
                "fields": {
                  "color": {
                    "render": false
                  }
                }
              }
            }
          },
          "htmlAttributes": {}
        },
        "decoration": {
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "title": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-context-library__title",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "Context Files"
          }
        }
      },
      "defaultPrintedStyle": {
        "decoration": {
          "font": {
            "font": {
              "desktop": {
                "value": {
                  "size": "22px",
                  "lineHeight": "1.3em",
                  "weight": "600"
                }
              }
            }
          }
        }
      },
      "tagName": "h3",
      "attributes": {
        "class": "leaderspath-context-library__title"
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentTitle",
            "attrName": "title.innerContent",
            "label": "Title",
            "description": "Enter the module heading title.",
            "priority": 10,
            "render": true,
            "features": {
              "dynamicContent": false,
              "sticky": false
            },
            "component": {
              "type": "field",
              "name": "divi/text"
            }
          }
        },
        "decoration": {
          "font": {
            "priority": 10,
            "component": {
              "props": {
                "groupLabel": "Title Text",
                "fieldLabel": "Title"
              }
            }
          }
        }
      },
      "elementType": "heading",
      "inlineEditor": "plainText",
      "childrenSanitizer": "et_core_esc_previously"
    },
    "emptyState": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-context-library__empty",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "No context files are available for this lesson."
          }
        }
      },
      "tagName": "div",
      "attributes": {
        "class": "leaderspath-context-library__empty"
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "contentEmptyState",
            "attrName": "emptyState.innerContent",
            "label": "Empty State Message",
            "description": "Message shown when no context files are available.",
            "priority": 10,
            "render": true,
            "features": {
              "dynamicContent": false,
              "sticky": false
            },
            "component": {
              "type": "field",
              "name": "divi/richtext"
            }
          }
        },
        "decoration": {
          "bodyFont": {
            "attrName": "emptyState.decoration.bodyFont"
          }
        }
      },
      "inlineEditor": "richText",
      "childrenSanitizer": "et_core_esc_previously"
    },
    "contextFiles": {
      "type": "object",
      "settings": {
        "advanced": {
          "showDescription": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentElements",
              "attrName": "contextFiles.advanced.showDescription",
              "label": "Show Description",
              "description": "Show or hide context file descriptions.",
              "priority": 10,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          },
          "showFileType": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentElements",
              "attrName": "contextFiles.advanced.showFileType",
              "label": "Show File Type Badge",
              "description": "Show or hide the file type badge.",
              "priority": 20,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          },
          "showViewButton": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentElements",
              "attrName": "contextFiles.advanced.showViewButton",
              "label": "Show View Content Button",
              "description": "Show or hide the View Content button.",
              "priority": 30,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          },
          "showDownloadButton": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentElements",
              "attrName": "contextFiles.advanced.showDownloadButton",
              "label": "Show Download Button",
              "description": "Show or hide the Download button.",
              "priority": 40,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false
              },
              "component": {
                "type": "field",
                "name": "divi/toggle"
              }
            }
          }
        }
      },
      "default": {
        "advanced": {
          "showDescription": {
            "desktop": {
              "value": "on"
            }
          },
          "showFileType": {
            "desktop": {
              "value": "on"
            }
          },
          "showViewButton": {
            "desktop": {
              "value": "on"
            }
          },
          "showDownloadButton": {
            "desktop": {
              "value": "on"
            }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-context-library__item",
      "defaultPrintedStyle": {
        "decoration": {
          "background": {
            "color": {
              "desktop": {
                "value": "#f7f7f7"
              }
            }
          },
          "border": {
            "radius": {
              "desktop": {
                "value": {
                  "sync": true,
                  "topLeft": "8px",
                  "topRight": "8px",
                  "bottomRight": "8px",
                  "bottomLeft": "8px"
                }
              }
            }
          },
          "spacing": {
            "padding": {
              "desktop": {
                "value": "20px"
              }
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "background": {
            "priority": 30,
            "component": {
              "props": {
                "groupLabel": "Item Background"
              }
            }
          },
          "border": {
            "priority": 40,
            "component": {
              "props": {
                "groupLabel": "Item Border"
              }
            }
          },
          "spacing": {
            "priority": 50,
            "component": {
              "props": {
                "groupLabel": "Item Spacing"
              }
            }
          },
          "boxShadow": {
            "priority": 60,
            "component": {
              "props": {
                "groupLabel": "Item Box Shadow"
              }
            }
          }
        }
      }
    },
    "itemTitle": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-context-library__item-title",
      "defaultPrintedStyle": {
        "decoration": {
          "font": {
            "font": {
              "desktop": {
                "value": {
                  "size": "16px",
                  "lineHeight": "1.4em",
                  "weight": "600"
                }
              }
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "font": {
            "priority": 20,
            "component": {
              "props": {
                "groupLabel": "Item Title Text",
                "fieldLabel": "Item Title"
              }
            }
          }
        }
      }
    },
    "itemDescription": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-context-library__item-description",
      "defaultPrintedStyle": {
        "decoration": {
          "bodyFont": {
            "body": {
              "font": {
                "desktop": {
                  "value": {
                    "size": "14px",
                    "lineHeight": "1.6em",
                    "color": "#666666"
                  }
                }
              }
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "bodyFont": {
            "priority": 30,
            "attrName": "itemDescription.decoration.bodyFont",
            "component": {
              "props": {
                "groupLabel": "Item Description Text"
              }
            }
          }
        }
      }
    },
    "itemBadge": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-context-library__item-badge",
      "defaultPrintedStyle": {
        "decoration": {
          "background": {
            "color": {
              "desktop": {
                "value": "#e0e0e0"
              }
            }
          },
          "font": {
            "font": {
              "desktop": {
                "value": {
                  "size": "12px",
                  "weight": "500"
                }
              }
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "background": {
            "priority": 40,
            "component": {
              "props": {
                "groupLabel": "Badge Background"
              }
            }
          },
          "font": {
            "priority": 50,
            "component": {
              "props": {
                "groupLabel": "Badge Text",
                "fieldLabel": "Badge"
              }
            }
          },
          "border": {
            "priority": 60,
            "component": {
              "props": {
                "groupLabel": "Badge Border"
              }
            }
          }
        }
      }
    },
    "viewButton": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-context-library__view-button",
      "elementType": "button",
      "settings": {
        "decoration": {
          "button": {
            "priority": 70,
            "component": {
              "props": {
                "groupLabel": "View Button",
                "fieldLabel": "View Button",
                "fields": {
                  "alignment": {
                    "render": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "downloadButton": {
      "type": "object",
      "selector": "{{selector}} .leaderspath-context-library__download-button",
      "elementType": "button",
      "settings": {
        "decoration": {
          "button": {
            "priority": 80,
            "component": {
              "props": {
                "groupLabel": "Download Button",
                "fieldLabel": "Download Button",
                "fields": {
                  "alignment": {
                    "render": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "css": {
      "type": "object",
      "settings": {
        "advanced": {
          "customCss": {},
          "cssId": {},
          "cssClass": {}
        }
      }
    }
