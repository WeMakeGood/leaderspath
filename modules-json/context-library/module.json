    "title": {
      "subName": "title",
      "selectorSuffix": " .leaderspath-context-library__title"
    },
    "grid": {
      "subName": "grid",
      "selectorSuffix": " .leaderspath-context-library__grid"
    },
    "item": {
      "subName": "item",
      "selectorSuffix": " .leaderspath-context-library__item"
    },
    "itemHeader": {
      "subName": "itemHeader",
      "selectorSuffix": " .leaderspath-context-library__item-header"
    },
    "itemTitle": {
      "subName": "itemTitle",
      "selectorSuffix": " .leaderspath-context-library__item-title"
    },
    "itemBadge": {
      "subName": "itemBadge",
      "selectorSuffix": " .leaderspath-context-library__item-badge"
    },
    "itemDescription": {
      "subName": "itemDescription",
      "selectorSuffix": " .leaderspath-context-library__item-description"
    },
    "itemButtons": {
      "subName": "itemButtons",
      "selectorSuffix": " .leaderspath-context-library__item-buttons"
    },
    "viewButton": {
      "subName": "viewButton",
      "selectorSuffix": " .leaderspath-context-library__view-button"
    },
    "downloadButton": {
      "subName": "downloadButton",
      "selectorSuffix": " .leaderspath-context-library__download-button"
