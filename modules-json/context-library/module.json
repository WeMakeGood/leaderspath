            "groupLabel": "Title"
          }
        }
      },
      "contentElements": {
        "panel": "content",
        "priority": 20,
        "groupName": "elements",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Elements"
          }
        }
      },
      "contentEmptyState": {
        "panel": "content",
        "priority": 30,
        "groupName": "emptyState",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Empty State"
          }
        }
      }
